# ============================================================================
# JOBHUB ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your secrets
# Never commit .env to version control

# ============================================================================
# GENERAL
# ============================================================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://jobhub:jobhub_password@localhost:5432/jobhub_dev
DATABASE_ECHO=false

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT
JWT_SECRET=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@jobhub.co.za
SMTP_FROM_NAME=JobHub

# ============================================================================
# SMS (TWILIO)
# ============================================================================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+27xxxxxxxxx

# ============================================================================
# WHATSAPP (META)
# ============================================================================
WHATSAPP_BUSINESS_PHONE_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# ============================================================================
# CRYTONET (Identity Verification & Fraud Detection)
# ============================================================================
CRYTONET_API_KEY=your-crytonet-api-key
CRYTONET_API_URL=https://api.crytonet.io/v1
CRYTONET_WEBHOOK_SECRET=your-crytonet-webhook-secret

# CIPC Integration (via CRYTONET)
CIPC_API_KEY=your-cipc-api-key
CIPC_API_URL=https://api.cipc.gov.za/v1

# Home Affairs e-Verify (via CRYTONET)
HOME_AFFAIRS_API_KEY=your-home-affairs-key

# ============================================================================
# FILE STORAGE (SUPABASE)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=jobhub-uploads

# ============================================================================
# BACKGROUND JOBS (CELERY)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO

# ============================================================================
# FRONTEND
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=JobHub
VITE_APP_VERSION=0.1.0
